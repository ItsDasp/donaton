# Production Environment Configuration for AWS Deployment
# Copy this file to .env and update with actual values before deployment

# Azure AD Configuration
# These are required for Azure authentication
# Get these values from Azure Portal (App Registrations)
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id

# For initial deployment/testing with dummy values:
# AZURE_TENANT_ID=common
# AZURE_CLIENT_ID=dummy-client-id

# Database Configuration
# These are the default values used in docker-compose.yml
# For production, consider using stronger passwords
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mydatabase
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=secret

# RabbitMQ Configuration
# These are the default values used in docker-compose.yml
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_USERNAME=myuser
SPRING_RABBITMQ_PASSWORD=secret

# JWT Secret
# This should be a strong, random secret in production
# The docker-compose.yml currently uses a hardcoded value
JWT_SECRET=change-this-to-a-strong-random-secret-in-production

# Additional Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_MAIN_LAZY_INITIALIZATION=true